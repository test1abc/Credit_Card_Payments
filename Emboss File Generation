import java.io.BufferedWriter;
import java.io.FileWriter;
import java.io.IOException;
import java.util.List;

class Customer {
    String cardNumber;
    String customerName;
    String expiryDate;

    Customer(String cardNumber, String customerName, String expiryDate) {
        this.cardNumber = cardNumber;
        this.customerName = customerName;
        this.expiryDate = expiryDate;
    }
}

public class EmbossFileGenerator {

    public static void generateEmbossFile(List<Customer> customers, String fileName)
            throws IOException {

        try (BufferedWriter writer = new BufferedWriter(new FileWriter(fileName))) {

            for (Customer customer : customers) {

                String record =
                        String.format("%-19s", customer.cardNumber) +
                        String.format("%-26s", customer.customerName.toUpperCase()) +
                        String.format("%-4s", customer.expiryDate);

                writer.write(record);
                writer.newLine();
            }
        }
    }

    public static void main(String[] args) throws IOException {

        List<Customer> customers = List.of(
                new Customer("4111111111111111", "John Smith", "2806"),
                new Customer("5555444433332222", "Mary Johnson", "2908")
        );

        generateEmbossFile(customers, "EMBOSS.DAT");

        System.out.println("Emboss file generated successfully.");
    }
}

